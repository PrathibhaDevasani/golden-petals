---
const featuredVideo = {
  thumbnail: "/images/video-featured.jpeg",
  title: "Wedding Celesta",
  duration: "3:45",
};

const videos = [
  {
    thumbnail: "/images/video-1.jpeg",
    title: "Cocktail Evening",
    duration: "2:30",
  },
  {
    thumbnail: "/images/video-2.jpeg",
    title: "Gaali Gopuram",
    duration: "4:15",
  },
  {
    thumbnail: "/images/video-3.jpeg",
    title: "Hexagon Stage",
    duration: "3:00",
  },
];
---

<section
  class="flex flex-col items-center gap-12 w-full px-20 py-20 bg-[var(--warm-white)]"
>
  <!-- Section Header -->
  <div class="flex flex-col items-center gap-4">
    <span
      class="text-[var(--brand-gold-500)] font-body text-[13px] font-semibold tracking-[3px]"
    >
      WATCH OUR WORK
    </span>
    <h2
      class="font-heading text-[var(--charcoal-900)] text-[42px] font-bold text-center"
    >
      Stories Brought to Life
    </h2>
    <p
      class="font-body text-[var(--taupe-600)] text-base font-normal leading-[1.7] text-center max-w-[600px]"
    >
      Experience the magic of our celebrations through cinematic highlights<br
      />from our most cherished events.
    </p>
  </div>

  <!-- Divider -->
  <div class="flex items-center gap-4 w-[200px]">
    <div class="flex-1 h-px bg-[var(--brand-gold-500)]"></div>
    <svg
      class="w-[18px] h-[18px] text-[var(--brand-gold-500)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        d="m20.2 6 .94-2.06L23.2 3l-2.06-.94L20.2 0l-.94 2.06L17.2 3l2.06.94ZM5.2 11l.94-2.06L8.2 8l-2.06-.94L5.2 5l-.94 2.06L2.2 8l2.06.94Z"
      ></path>
      <rect width="14" height="10" x="5" y="10" rx="2"></rect>
      <path d="m5 18 7-5 7 5"></path>
    </svg>
    <div class="flex-1 h-px bg-[var(--brand-gold-500)]"></div>
  </div>

  <!-- Featured Video -->
  <div
    class="relative w-full h-[520px] rounded-[var(--radius-lg)] overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.1)] bg-cover bg-center"
    style={`background-image: url('${featuredVideo.thumbnail}')`}
  >
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[#1A150E44]"></div>

    <!-- Play Button -->
    <button
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 flex items-center justify-center rounded-full bg-[var(--brand-gold-500)] shadow-[0_4px_20px_rgba(198,167,94,0.4)] hover:scale-110 transition-transform"
      aria-label="Play video"
    >
      <svg class="w-8 h-8 fill-[var(--white)] ml-1" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </button>

    <!-- Caption Bar -->
    <div
      class="absolute bottom-0 left-0 right-0 flex items-center justify-between px-8 py-5"
      style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent)"
    >
      <h3 class="font-heading text-[var(--white)] text-xl font-semibold">
        {featuredVideo.title}
      </h3>
      <div
        class="flex items-center gap-1.5 px-3 py-1.5 bg-[rgba(0,0,0,0.4)] rounded-full"
      >
        <svg
          class="w-3 h-3 text-[var(--white)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span class="text-[var(--white)] font-body text-xs">
          {featuredVideo.duration}
        </span>
      </div>
    </div>
  </div>

  <!-- Video Grid -->
  <div class="grid grid-cols-3 gap-6 w-full">
    {
      videos.map((video) => (
        <div
          class="relative h-[300px] rounded-[var(--radius-lg)] overflow-hidden shadow-[0_4px_16px_rgba(0,0,0,0.05)] bg-cover bg-center group cursor-pointer"
          style={`background-image: url('${video.thumbnail}')`}
        >
          {/* Overlay */}
          <div class="absolute inset-0 bg-[#1A150E33] group-hover:bg-[#1A150E55] transition-colors" />

          {/* Play Button */}
          <button
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 flex items-center justify-center rounded-full bg-[var(--brand-gold-500)] shadow-[0_2px_12px_rgba(198,167,94,0.33)] group-hover:scale-110 transition-transform"
            aria-label="Play video"
          >
            <svg class="w-6 h-6 fill-[var(--white)] ml-0.5" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
          </button>

          {/* Caption */}
          <div
            class="absolute bottom-0 left-0 right-0 flex items-center justify-between px-5 py-4"
            style="background: linear-gradient(to top, rgba(0,0,0,0.73), transparent)"
          >
            <h4 class="font-heading text-[var(--white)] text-base font-semibold">
              {video.title}
            </h4>
            <div class="flex items-center gap-1.5 px-2.5 py-1 bg-[rgba(0,0,0,0.4)] rounded-full">
              <svg
                class="w-2.5 h-2.5 text-[var(--white)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span class="text-[var(--white)] font-body text-[11px]">
                {video.duration}
              </span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
