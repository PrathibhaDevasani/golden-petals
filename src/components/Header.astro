---
interface Props {
  logoSrc?: string;
}

const { logoSrc = "/images/logo.png" } = Astro.props;

const navLinks = [
  { label: "Services", href: "#services" },
  { label: "Portfolio", href: "#portfolio" },
  { label: "Testimonials", href: "#testimonials" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="flex items-center justify-between h-[72px] px-8 bg-[var(--white)] shadow-[0_2px_8px_rgba(0,0,0,0.04)] sticky top-0 z-50"
>
  <!-- Left: Logo -->
  <div class="flex items-center gap-8">
    <a href="/">
      <img
        src={logoSrc}
        alt="Golden Petals"
        class="h-14 w-auto object-contain"
      />
    </a>
  </div>

  <!-- Center: Navigation -->
  <nav class="flex items-center gap-8">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[var(--taupe-600)] font-body text-sm font-medium hover:text-[var(--brand-gold-500)] transition-colors"
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <!-- Right: Actions -->
  <div class="flex items-center gap-4">
    <button
      class="text-[var(--taupe-600)] hover:text-[var(--brand-gold-500)] transition-colors"
      aria-label="Search"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>
    <button
      class="text-[var(--taupe-600)] hover:text-[var(--brand-gold-500)] transition-colors"
      aria-label="Shopping bag"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4ZM3 6h18M16 10a4 4 0 0 1-8 0"
        ></path>
      </svg>
    </button>
    <a
      href="#contact"
      class="flex items-center justify-center gap-2 px-8 py-4 bg-[var(--brand-gold-500)] text-[var(--white)] font-body text-base font-medium rounded-full hover:bg-[var(--brand-gold-700)] transition-colors"
    >
      Get a Quote
    </a>
  </div>
</header>
