---
const instagramImages = [
    "/images/insta-1.webp",
    "/images/insta-2.webp",
    "/images/insta-3.webp",
    "/images/insta-4.webp",
    "/images/insta-5.webp",
];
---

<section
    class="flex flex-col items-center gap-8 w-full px-5 md:px-10 lg:px-20 py-12 lg:py-16 bg-[var(--cream-50)]"
>
    <!-- Header -->
    <div class="flex flex-col items-center gap-3">
        <span
            class="text-[var(--brand-gold-700)] font-body text-[13px] font-semibold tracking-[3px]"
        >
            FOLLOW US ON INSTAGRAM
        </span>
        <h2
            class="font-heading text-[var(--charcoal-900)] text-[28px] md:text-[32px] font-bold"
        >
            @the.golden.petals
        </h2>
    </div>

    <!-- Mobile Instagram Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full lg:hidden">
        {
            instagramImages.map((image) => (
                <a
                    href="https://instagram.com/the.golden.petals"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="View on Instagram"
                    class="relative h-[150px] sm:h-[180px] rounded-[var(--radius-sm)] overflow-hidden group"
                >
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-300 group-hover:scale-110"
                        style={`background-image: url('${image}')`}
                    />
                    <div class="absolute inset-0 bg-[#00000044] opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                        <svg
                            class="w-8 h-8 text-[var(--white)]"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"
                            />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                        </svg>
                    </div>
                </a>
            ))
        }
    </div>

    <!-- Desktop Instagram Grid -->
    <div class="hidden lg:flex gap-3 w-full h-[240px]">
        {
            instagramImages.map((image) => (
                <a
                    href="https://instagram.com/the.golden.petals"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="View on Instagram"
                    class="relative flex-1 h-full rounded-[var(--radius-sm)] overflow-hidden group"
                >
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-300 group-hover:scale-110"
                        style={`background-image: url('${image}')`}
                    />
                    <div class="absolute inset-0 bg-[#00000044] opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                        <svg
                            class="w-8 h-8 text-[var(--white)]"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"
                            />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                        </svg>
                    </div>
                </a>
            ))
        }
    </div>

    <!-- WhatsApp FAB -->
    <a
        href="https://wa.me/919030714446"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-6 py-3.5 bg-[var(--whatsapp-green)] text-[var(--white)] rounded-[28px] shadow-[0_4px_16px_rgba(37,211,102,0.27)] hover:shadow-[0_6px_20px_rgba(37,211,102,0.4)] transition-shadow"
    >
        <svg class="w-[22px] h-[22px] fill-[var(--white)]" viewBox="0 0 24 24">
            <path
                d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></path>
        </svg>
        <span class="font-body text-sm font-semibold">Chat with us</span>
    </a>
</section>
