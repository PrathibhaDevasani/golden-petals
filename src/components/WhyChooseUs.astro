---
const features = [
  {
    icon: "palette",
    text: "Bespoke designs tailored to your vision",
  },
  {
    icon: "flower",
    text: "Premium florals and finest materials",
  },
  {
    icon: "crown",
    text: "White-glove service from concept to execution",
  },
];

const icons: Record<string, string> = {
  palette: `<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="14" r="3" fill="none" stroke="currentColor" stroke-width="2"/>`,
  flower: `<path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 1 0 4.5 4.5M7.5 12H9m3 4.5V15m4.5-3a4.5 4.5 0 1 1-4.5 4.5m4.5-4.5H15" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="2" fill="currentColor"/>`,
  crown: `<path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7Zm3 16h14" fill="none" stroke="currentColor" stroke-width="2"/>`,
};
---

<section
  class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16 w-full px-5 md:px-10 lg:px-20 py-12 lg:py-20 bg-[var(--cream-50)]"
>
  <!-- Left Content -->
  <div class="flex flex-col gap-8 flex-1">
    <span
      class="text-[var(--brand-gold-700)] font-body text-[13px] font-semibold tracking-[3px]"
    >
      WHY CHOOSE US
    </span>

    <h2
      class="font-heading text-[var(--charcoal-900)] text-[28px] md:text-[36px] lg:text-[40px] font-bold leading-[1.2]"
    >
      Every Detail, Perfectly Curated
    </h2>

    <p
      class="font-body text-[var(--taupe-600)] text-base font-normal leading-[1.7]"
    >
      We don't just decorate spaces — we create immersive experiences. Our team
      of artisans combines traditional craftsmanship with contemporary design to
      deliver events that surpass your imagination.
    </p>

    <!-- Features List -->
    <div class="flex flex-col gap-4">
      {
        features.map((feature) => (
          <div class="flex items-center gap-3">
            <svg
              class="w-5 h-5 text-[var(--brand-gold-500)]"
              viewBox="0 0 24 24"
              set:html={icons[feature.icon]}
            />
            <span class="font-body text-[var(--charcoal-900)] text-[15px] font-normal">
              {feature.text}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Right Image -->
  <div
    class="w-full lg:flex-1 h-[260px] sm:h-[360px] lg:h-[500px] rounded-[var(--radius-lg)] bg-cover bg-center"
    style="background-image: url('/images/why-choose-us.webp')"
  >
  </div>
</section>
