---
const stats = [
  {
    icon: "calendar-check",
    value: "500+",
    label: "Events Decorated",
  },
  {
    icon: "award",
    value: "8+",
    label: "Years of Excellence",
  },
  {
    icon: "smile",
    value: "100%",
    label: "Client Satisfaction",
  },
  {
    icon: "users",
    value: "50+",
    label: "Expert Artisans",
  },
];

const icons: Record<string, string> = {
  "calendar-check": `<rect width="18" height="18" x="3" y="4" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="2"/><line x1="16" x2="16" y1="2" y2="6" stroke="currentColor" stroke-width="2"/><line x1="8" x2="8" y1="2" y2="6" stroke="currentColor" stroke-width="2"/><line x1="3" x2="21" y1="10" y2="10" stroke="currentColor" stroke-width="2"/><path d="m9 16 2 2 4-4" fill="none" stroke="currentColor" stroke-width="2"/>`,
  award: `<circle cx="12" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" fill="none" stroke="currentColor" stroke-width="2"/>`,
  smile: `<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 14s1.5 2 4 2 4-2 4-2" fill="none" stroke="currentColor" stroke-width="2"/><line x1="9" x2="9.01" y1="9" y2="9" stroke="currentColor" stroke-width="2"/><line x1="15" x2="15.01" y1="9" y2="9" stroke="currentColor" stroke-width="2"/>`,
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 3.13a4 4 0 0 1 0 7.75" fill="none" stroke="currentColor" stroke-width="2"/>`,
};
---

<section
  class="flex items-center justify-around w-full px-20 py-12 bg-[var(--brand-gold-500)]"
>
  {
    stats.map((stat) => (
      <div class="flex flex-col items-center gap-2">
        <svg
          class="w-7 h-7 text-[#FFFFFFCC]"
          viewBox="0 0 24 24"
          set:html={icons[stat.icon]}
        />
        <span class="font-heading text-[var(--white)] text-[40px] font-bold">
          {stat.value}
        </span>
        <span class="font-body text-[#FFFFFFCC] text-sm font-medium">
          {stat.label}
        </span>
      </div>
    ))
  }
</section>
