---
const testimonials = [
  {
    quote:
      "The Golden Petals transformed our wedding into a fairy tale. The mandap was beyond anything we imagined — every guest was in awe.",
    author: "Priya & Arjun",
    location: "Wedding, Hyderabad",
    rating: 5,
  },
  {
    quote:
      "Our daughter's birthday party was pure magic. The fairy tale theme with giant butterflies and enchanted gardens was spectacular.",
    author: "Meera Sharma",
    location: "Birthday Celebration",
    rating: 5,
  },
  {
    quote:
      "From the traditional pellikuthuru to the grand reception, every detail was handled with such care and artistry. Truly exceptional.",
    author: "Lakshmi & Venkat",
    location: "Wedding, Bangalore",
    rating: 5,
  },
];
---

<section
  id="testimonials"
  class="flex flex-col items-center gap-12 w-full px-5 md:px-10 lg:px-20 py-12 lg:py-20 bg-[var(--warm-white)]"
>
  <!-- Section Header -->
  <div class="flex flex-col items-center gap-4">
    <span
      class="text-[var(--brand-gold-700)] font-body text-[13px] font-semibold tracking-[3px]"
    >
      TESTIMONIALS
    </span>
    <h2
      class="font-heading text-[var(--charcoal-900)] text-[28px] md:text-[36px] lg:text-[42px] font-bold text-center"
    >
      Words From Our Cherished Clients
    </h2>
  </div>

  <!-- Testimonials Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
    {
      testimonials.map((testimonial) => (
        <article class="flex flex-col gap-4 p-8 bg-[var(--white)] rounded-[var(--radius-lg)] shadow-[0_4px_12px_rgba(0,0,0,0.05)]">
          {/* Quote Icon */}
          <svg
            class="w-6 h-6 text-[var(--brand-gold-500)]"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z" />
            <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
          </svg>

          {/* Stars */}
          <div class="flex gap-1">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg
                class="w-4 h-4 fill-[var(--star-yellow)]"
                viewBox="0 0 24 24"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>

          {/* Quote */}
          <p class="font-heading text-[var(--charcoal-900)] text-lg font-normal italic leading-[1.6]">
            {testimonial.quote}
          </p>

          {/* Divider */}
          <div class="w-12 h-0.5 bg-[var(--brand-gold-500)]" />

          {/* Author */}
          <div class="flex flex-col gap-1">
            <span class="font-body text-[var(--charcoal-900)] text-sm font-semibold">
              {testimonial.author}
            </span>
            <span class="font-body text-[var(--taupe-600)] text-xs font-normal">
              {testimonial.location}
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
